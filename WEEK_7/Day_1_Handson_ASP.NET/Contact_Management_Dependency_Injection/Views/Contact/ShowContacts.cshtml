@model List<ContactInfo>

<h2>Contact List</h2>

<a href="/Contact/AddContact">Add New Contact</a>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Company</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>Action</th>
    </tr>

    @foreach (var c in Model)
    {
        <tr>
            <td>@c.ContactId</td>
            <td>@c.FirstName @c.LastName</td>
            <td>@c.CompanyName</td>
            <td>@c.EmailId</td>
            <td>@c.MobileNo</td>
            <td>
                <a href="/Contact/GetContactById/@c.ContactId">View</a>
            </td>
        </tr>
    }
</table>