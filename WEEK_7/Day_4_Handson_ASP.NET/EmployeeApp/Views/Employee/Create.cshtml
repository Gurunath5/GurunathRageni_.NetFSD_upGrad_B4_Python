@model Employee

<h2>Add Employee</h2>

<form asp-action="Create" method="post">

    <label>Name:</label><br />
    <input asp-for="Name" /><br /><br />

    <label>Department:</label><br />
    <input asp-for="Department" /><br /><br />

    <label>Salary:</label><br />
    <input asp-for="Salary" type="number" /><br /><br />

    <label>Hire Date:</label><br />
    <input asp-for="HireDate" type="date" /><br /><br />

    <button type="submit">Save</button>

</form>

